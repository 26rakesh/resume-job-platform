# PRODUCTION TEMPLATE — copy to backend/.env on the server only.
# Replace every <placeholder>. Never commit the real .env.

APP_NAME="Jobs Platform"
APP_ENV=production
APP_KEY=                          # generated on server: php artisan key:generate
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://jobs.sunrisepaint.in

FRONTEND_URL=https://jobs.sunrisepaint.in

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily                  # daily rotation for production
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error                  # never debug in production

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.sunrisepaint.in  # parent domain so subdomain session works
SESSION_SECURE_COOKIE=true       # HTTPS only
SESSION_HTTP_ONLY=true           # not readable by JS
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=jobs_

# Sanctum: only this domain is stateful
SANCTUM_STATEFUL_DOMAINS=jobs.sunrisepaint.in

# MySQL (Hostinger — credentials from hPanel, DB user must have ALL PRIVILEGES on this DB only)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<hpanel_db_name>
DB_USERNAME=<hpanel_db_user>
DB_PASSWORD=<hpanel_db_password>

# AI Provider
GEMINI_API_KEY=<gemini_key>
GEMINI_MODEL=gemini-2.0-flash-exp

# File Upload
MAX_UPLOAD_SIZE=10485760
ALLOWED_RESUME_TYPES=pdf,docx
