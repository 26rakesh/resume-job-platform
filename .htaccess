# Deny ALL browser access to the Git deployment directory.
# This directory (public_html/jobs-platform) contains full source code,
# .git, backend config and must never be web-accessible.
# The live site is served from public_html/ itself (index.php + app/).

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

# Belt-and-suspenders: explicitly block sensitive paths if the above is ignored
<FilesMatch "(^\.|\.env|\.git|composer\.(json|lock)|artisan|\.htaccess)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
